#!/usr/bin/env bash
#MISE description="Diff the rendered chart against another revision"
#USAGE arg "[base]" help="The revision to diff against, by default where HEAD branched off origin/main"
set -euo pipefail

base="${usage_base:-$(git merge-base origin/main HEAD)}"
workdir="$(mktemp -d)"
trap 'git worktree remove --force "$workdir" >/dev/null 2>&1; rm -rf "$workdir"' EXIT

git worktree add --quiet --detach "$workdir" "$base"
helm diff local "$workdir/charts/kupra" charts/kupra \
  --release kupra --namespace kupra-system --include-crds --no-color
