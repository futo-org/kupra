#!/usr/bin/env bash
#MISE description="Print the end-to-end test cluster's state, to debug failed tests"
set -uo pipefail

export KUBECONFIG="$PWD/.e2e/kubeconfig"
k() { kubectl --context kind-kupra-e2e "$@"; }

k get previewapps,previews,previewsnapshots,clusters.postgresql.cnpg.io,backups.postgresql.cnpg.io,volumesnapshots,pods,pvc -A -o wide
k get events -A --sort-by=.lastTimestamp
# Deletion times, finalizers and conditions show what's holding up a deletion.
k get namespaces -o custom-columns=NAME:.metadata.name,DELETING:.metadata.deletionTimestamp,FINALIZERS:.spec.finalizers,CONDITIONS:.status.conditions
# The namespace controller's view, for namespaces that don't finish deleting.
k -n kube-system logs -l component=kube-controller-manager --tail=-1 | grep -iE 'namespace|e2e-' | tail -100
k get previews,clusters.postgresql.cnpg.io,pvc,volumesnapshots,volumesnapshotcontents -A \
  -o custom-columns=KIND:.kind,NAMESPACE:.metadata.namespace,NAME:.metadata.name,DELETING:.metadata.deletionTimestamp,FINALIZERS:.metadata.finalizers
k get previews,previewsnapshots -A -o custom-columns=KIND:.kind,NAMESPACE:.metadata.namespace,NAME:.metadata.name,CONDITIONS:.status.conditions
for ns in $(k get namespaces -o name | grep -E "/e2e-"); do
  ns="${ns#namespace/}"
  for pod in $(k -n "$ns" get pods -o name); do
    echo "=== $ns/$pod"
    k -n "$ns" logs "$pod" --all-containers --tail=50
  done
done

# For each namespace stuck deleting: the namespace, everything still in it with its creation and write times, and every log line about it.
for ns in $(k get namespaces -o jsonpath='{range .items[?(@.metadata.deletionTimestamp)]}{.metadata.name}{"\n"}{end}'); do
  echo "=== namespace $ns, stuck deleting"
  k get namespace "$ns" -o yaml
  for resource in $(k api-resources --namespaced --verbs=list -o name); do
    k -n "$ns" get "$resource" --ignore-not-found --show-managed-fields \
      -o custom-columns=KIND:.kind,NAME:.metadata.name,UID:.metadata.uid,CREATED:.metadata.creationTimestamp,DELETING:.metadata.deletionTimestamp,FINALIZERS:.metadata.finalizers,WRITES:.metadata.managedFields[*].time,BY:.metadata.managedFields[*].manager 2>/dev/null | tail -n +2
  done
  k -n kube-system logs -l component=kube-controller-manager --tail=-1 | grep -F "$ns"
  k -n kube-system logs -l component=kube-apiserver --tail=-1 | grep -F "$ns" | tail -50
  k -n cnpg-system logs deployment/cnpg-controller-manager --tail=-1 | grep -F "$ns" | tail -100
done
