{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm's global values, set by a parent chart.",
      "type": "object"
    },
    "commonLabels": {
      "description": "Labels added to the objects the chart templates, except its ClusterRoles, which other roles can aggregate by label, and its CRDs. They can't replace the chart's own labels.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string"},
            "tag": {"description": "Defaults to the chart's appVersion.", "type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
        "extraArgs": {"description": "Arguments added to the operator's command line.", "type": "array", "items": {"type": "string"}},
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "podSecurityContext": {"type": ["object", "null"]},
        "securityContext": {"type": ["object", "null"]},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"}
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "publicURL": {"description": "Where people reach the dashboard.", "type": "string"},
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerURL": {"type": "string"},
            "clientID": {"type": "string"},
            "scopes": {"type": "array", "items": {"type": "string"}}
          }
        },
        "existingSecret": {"description": "A Secret with client-secret and cookie-secret.", "type": "string"},
        "replicas": {"type": "integer", "minimum": 0},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string"},
            "tag": {"description": "Defaults to the chart's appVersion.", "type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
        "extraArgs": {"description": "Arguments added to the dashboard's command line.", "type": "array", "items": {"type": "string"}},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "podSecurityContext": {"type": ["object", "null"]},
        "securityContext": {"type": ["object", "null"]},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"}
      }
    },
    "defaultPolicy": {
      "description": "The spec of the default PreviewPolicy.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apply": {"type": ["object", "null"]},
        "networkPolicies": {"type": ["array", "null"]},
        "apiServerAccess": {"type": ["object", "null"]},
        "resourceQuota": {"type": ["object", "null"]},
        "limitRange": {"type": ["object", "null"]},
        "namespaceMetadata": {"type": ["object", "null"]}
      }
    }
  }
}
